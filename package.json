{
  "name": "Cogulator",
  "productName": "Cogulator",
  "version": "5.0.0",
  "description": "Cogulator: A Cognitive Calculator",
  "main": "src/index.js",
  "scripts": {
    "dev": "npm start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release:mac": "bash ./scripts/release-macos.sh",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "test": "node --test test/*.test.js",
    "prestart": "node scripts/prepare-embeddings.js",
    "prepackage": "node scripts/prepare-embeddings.js",
    "premake": "node scripts/prepare-embeddings.js",
    "prepublish": "node scripts/prepare-embeddings.js",
    "pretest:embeddings": "node scripts/prepare-embeddings.js",
    "test:embeddings": "electron scripts/test-embeddings.cjs",
    "pretest:app": "node scripts/prepare-embeddings.js",
    "test:app": "electron scripts/test-app.cjs"
  },
  "keywords": [],
  "author": {
    "name": "The MITRE Corp",
    "email": "sestes@mitre.org"
  },
  "license": "Apache-2.0",
  "config": {
    "forge": {
      "packagerConfig": {
        "packageManager": "npm",
        "icon": "./src/icons/1024x1024",
        "ignore": [
          "(^|[\\/])\\.env(?:\\..*)?$",
          "(^|[\\/])src[\\/]RAG(?:[\\/]|$)",
          "^/(?:out|scripts|test)(?:/|$)"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "Cogulator",
            "setupIcon": "./src/icons/1024x1024.ico",
            "loadingGif": "./src/icons/cogulator_win_loading.gif"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {
            "icon": "./src/icons/1024x1024.icns",
            "format": "ULFO"
          }
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  },
  "dependencies": {
    "electron-json-config": "^2.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "groq-sdk": "^1.1.2",
    "jquery": "^3.5.1",
    "node-fetch": "^2.7.0",
    "trash": "^10.0.0",
    "update-electron-app": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "electron": "44.5.1",
    "@xenova/transformers": "2.17.2",
    "@electron/packager": "^18.4.4",
    "@electron/osx-sign": "^1.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cogulator/Cogulator.git"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.4": true,
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true
  }
}
